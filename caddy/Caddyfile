{
	# Issue all certificates from Caddy's own local CA (no internet, no public DNS).
	local_certs
}

(security) {
	# Browsers must only ever use HTTPS for these hosts.
	header Strict-Transport-Security "max-age=31536000"
}

tt.{$LIFELOG_DOMAIN} {
	import security
	reverse_proxy timetagger:80
}

dash.{$LIFELOG_DOMAIN} {
	import security
	reverse_proxy grafana:3000
}

sync.{$LIFELOG_DOMAIN} {
	import security
	# Login for the goals page and the sync button. The IP allowlist comes in M4.
	basic_auth {
		{$SYNC_BASIC_AUTH_USER} {$SYNC_BASIC_AUTH_HASH}
	}
	request_body {
		max_size 16KiB
	}
	# Keep the client's Host header (the default): the goals page's CSRF check compares it with Origin.
	reverse_proxy ingestor:8000
}
